{
  "dep": {
    "prefix": "dep",
    "body": [
      "${1:serde} = { version = \"${2:1.0}\", features = [\"${3:derive}\"] }",
      ""
    ],
    "description": "Add Cargo.toml dependency",
    "luasnip": {
      "priority": 2000,
      "autotrigger": true,
      "wordTrig": false
    }
  },
  "bin": {
    "prefix": "bin",
    "body": [
      "[[bin]]",
      "name = \"${1:name}\"",
      "path = \"${2:src/bin/$1.rs}\""
    ],
    "description": "Add Cargo.toml binary target"
  }
}
